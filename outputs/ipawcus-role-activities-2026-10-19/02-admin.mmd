    n_c2_consent("Capture and save the signed or<br/>physical owner consent document<br/>(Admin / Pet Owner)")
    n_c2_consentSaved{"Required consent<br/>saved?"}
    n_c2_consentSaved_recovery("Save valid consent before<br/>completing the examination<br/>(Admin)")
