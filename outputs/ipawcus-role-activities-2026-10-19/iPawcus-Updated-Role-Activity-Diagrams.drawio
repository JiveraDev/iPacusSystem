<mxCell id="text-0" value="iPawcus  |  Super Admin Activity Diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="25" width="2580" height="45" as="geometry"/></mxCell>
<mxCell id="text-1" value="Accounts, branch/feature authority, reports, payment configuration, oversight, and local backup export" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="78" width="2580" height="28" as="geometry"/></mxCell>
<mxCell id="text-2" value="Current local implementation reviewed: 19 October 2026  |  Rounded box: activity  |  Diamond: decision / merge  |  Small label: responsible actor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="116" width="2580" height="28" as="geometry"/></mxCell>
<mxCell id="text-3" value="Reading the revised diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2680" width="2580" height="30" as="geometry"/></mxCell>
<mxCell id="text-4" value="Columns are alternative work areas. Merge diamonds combine alternatives; they do not wait for every activity to finish. Pending reviews may be revisited later." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2719" width="2580" height="30" as="geometry"/></mxCell>
<mxCell id="text-5" value="Use the selected action's validation rules. For a timeout or uncertain write result, refresh the record before resubmitting. Leaving an activity returns to the menu." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2749" width="2580" height="30" as="geometry"/></mxCell>
<mxCell id="text-6" value="Archive is an administrative account label in the current code; do not describe it as revoking existing tokens or reliably blocking password login." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2779" width="2580" height="30" as="geometry"/></mxCell>
<mxCell id="text-7" value="Reports, staff Activity Log, media review, and lifecycle recovery reporting are separate workspaces. The recovery report does not repair records." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2809" width="2580" height="30" as="geometry"/></mxCell>
<mxCell id="text-8" value="Backup exports download locally; no retained ZIP, automated schedule, in-app restore, or verified disaster-recovery workflow is implied." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2839" width="2580" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
