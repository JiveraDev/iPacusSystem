<mxCell id="text-0" value="iPawcus  |  Admin Activity Diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="25" width="2940" height="45" as="geometry"/></mxCell>
<mxCell id="text-1" value="Reception, physical examination, grooming, boarding, billing, stock, and controlled record/configuration work" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="78" width="2940" height="28" as="geometry"/></mxCell>
<mxCell id="text-2" value="Current local implementation reviewed: 19 October 2026  |  Rounded box: activity  |  Diamond: decision / merge  |  Small label: responsible actor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="116" width="2940" height="28" as="geometry"/></mxCell>
<mxCell id="text-3" value="Reading the revised diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3007" width="2940" height="30" as="geometry"/></mxCell>
<mxCell id="text-4" value="Columns are alternative work areas. Merge diamonds combine alternatives; they do not wait for every activity to finish. Pending reviews may be revisited later." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3046" width="2940" height="30" as="geometry"/></mxCell>
<mxCell id="text-5" value="Use the selected action's validation rules. For a timeout or uncertain write result, refresh the record before resubmitting. Leaving an activity returns to the menu." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3076" width="2940" height="30" as="geometry"/></mxCell>
<mxCell id="text-6" value="Clinical handoff: Admin assignment creates a received vet assignment and places the queue in progress; My List reflects that assignment." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3106" width="2940" height="30" as="geometry"/></mxCell>
<mxCell id="text-7" value="Saved consent and completed intake precede clinical finalization where intake storage is installed. Generic status edits cannot complete clinical work." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3136" width="2940" height="30" as="geometry"/></mxCell>
<mxCell id="text-8" value="Refund handlers exist, but POS has no active Record Refund action. Grooming release follows verified full POS payment; staff still check actual collection." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3166" width="2940" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
