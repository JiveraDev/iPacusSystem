<mxCell id="BillingRecord-attribute-3" value="- payments: List" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="81" width="154" height="16" as="geometry"/></mxCell>
<mxCell id="BillingRecord-attribute-4" value="- refunds: List" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="97" width="154" height="16" as="geometry"/></mxCell>
