<mxCell id="BillingRecord-operation-4" value="+ calculateBalance()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="201" width="154" height="16" as="geometry"/></mxCell>
<mxCell id="BillingRecord-operation-5" value="+ saveInvoice()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="217" width="154" height="16" as="geometry"/></mxCell>
<object id="Booking" label="Booking" tooltip="Represents a scheduled service request. Supporting pet links allow multiple registered patients, while legacy/unregistered-pet booking details are retained in the implementation. Onsite bookings use clinic hours and a reserved eligible veterinarian. Online consultations use the veterinarian&apos;s separate call slots, although both calendars prevent an individual veterinarian from overlapping appointments. Branch transfers, status changes and service details remain covered. Online, grooming and boarding bookings lead to their corresponding workflows; not every booking requires a physical examination.
Supporting mappings: bookings, booking_branch_transfers, booking_pets, special_service_booking_items"><mxCell style="swimlane;html=0;horizontal=1;startSize=30;align=center;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#111111;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="621" y="477" width="208" height="238" as="geometry"/></mxCell></object>
