<mxCell id="text-0" value="iPawcus  |  Veterinarian Activity Diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="25" width="2220" height="45" as="geometry"/></mxCell>
<mxCell id="text-1" value="Assigned clinical care, online consultations, record work, prescriptions/certificates, review, and availability" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="78" width="2220" height="28" as="geometry"/></mxCell>
<mxCell id="text-2" value="Current local implementation reviewed: 19 October 2026  |  Rounded box: activity  |  Diamond: decision / merge  |  Small label: responsible actor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="116" width="2220" height="28" as="geometry"/></mxCell>
<mxCell id="text-3" value="Reading the revised diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3084" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-4" value="Columns are alternative work areas. Merge diamonds combine alternatives; they do not wait for every activity to finish. Pending reviews may be revisited later." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3123" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-5" value="Use the selected action's validation rules. For a timeout or uncertain write result, refresh the record before resubmitting. Leaving an activity returns to the menu." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3153" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-6" value="Current My List is populated by Admin queue assignment. Do not add a compulsory separate Approved List / receive-case screen." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3183" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-7" value="Diagnosis finalization checks the assigned completed intake where installed. Clinical completion creates/reuses billing context; it does not verify payment." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3213" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-8" value="Online availability is a separate recurring call-start calendar. Published branch visits are retired. Only the actual veterinarian role issues medical certificates." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3243" width="2220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
