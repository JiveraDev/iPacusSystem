<mxCell id="Pet-attribute-5" value="- status: String" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Pet"><mxGeometry y="113" width="134" height="16" as="geometry"/></mxCell>
