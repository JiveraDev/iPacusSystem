<mxCell id="Notification-operation-2" value="+ updatePreferences()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Notification"><mxGeometry y="153" width="176" height="16" as="geometry"/></mxCell>
<object id="BillingRecord" label="BillingRecord" tooltip="Represents the visit-centered financial record, not a single payment. Charge lines, invoices, booking payment proofs, reviewed payments and refunds remain distinct supporting records within this simplified explanation. Service catalogues define available service prices and required materials; they are referenced by booking, care and billing rather than becoming extra overview classes. Walk-in billing may exist without a booking. Calculate balance uses recorded charges, payments and refunds; it does not silently erase payment history.
Supporting mappings: visits, visit_charges, visit_invoice_documents, visit_payments, visit_payment_refunds, booking_payment_submissions, booking_payment_refunds, payment_methods, service_catalog, service_display_settings, service_materials, special_service_catalog"><mxCell style="swimlane;html=0;horizontal=1;startSize=30;align=center;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#111111;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="178" y="397" width="154" height="238" as="geometry"/></mxCell></object>
<mxCell id="BillingRecord-attribute-0" value="- visitId: Integer" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="33" width="154" height="16" as="geometry"/></mxCell>
<mxCell id="BillingRecord-attribute-1" value="- patient: Pet" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="BillingRecord"><mxGeometry y="49" width="154" height="16" as="geometry"/></mxCell>
