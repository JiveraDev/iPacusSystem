<mxCell id="heading" value="iPawcus — Simplified System Class Diagram" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="16" width="1740" height="28" as="geometry"/></mxCell>
<mxCell id="system-title" value="iPawcus: A Web-Based Veterinary Management System with Online Booking and Pet Record Management for Vetfocus Care Animal Clinic" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="46" width="1740" height="28" as="geometry"/></mxCell>
<mxCell id="legend" value="16 main classes · Attributes + operations · Solid: association · Dashed arrow: uses · 1: one · 0..1: optional · 0..*: many · ?: optional value" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="72" width="1740" height="28" as="geometry"/></mxCell>
<object id="Clinic" label="Clinic" tooltip="Represents a clinic and its operating calendar. Onsite medical capacity is determined by active veterinarians assigned to that clinic who accept bookings, with conflicts checked across sites and online calls. Three eligible veterinarians allow three simultaneous medical appointments, including the same service. Grooming and boarding retain their separate capacity rules. Legacy veterinarian working-hours, time-off and clinic-visit tables are reference data only; they are not current onsite scheduling gates.
Supporting mappings: branches, branch_closures, branch_operating_hours, branch_service_availability, veterinarian_booking_time_off, veterinarian_branch_schedules, veterinarian_working_hours, domain:booking_scheduler"><mxCell style="swimlane;html=0;horizontal=1;startSize=30;align=center;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#111111;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="160" y="135" width="190" height="190" as="geometry"/></mxCell></object>
