<Files ".env">
      Require all denied
  </Files>

  <IfModule mod_mime.c>
      AddType application/manifest+json .webmanifest
  </IfModule>

  <IfModule mod_rewrite.c>
      RewriteEngine On

      RewriteRule ^php/ - [L]
      RewriteRule ^api/?(.*)$ php/index.php/api/$1 [QSA,L]

      RewriteCond %{REQUEST_FILENAME} !-f
      RewriteCond %{REQUEST_FILENAME} !-d
      RewriteRule . index.html [L]
  </IfModule>
