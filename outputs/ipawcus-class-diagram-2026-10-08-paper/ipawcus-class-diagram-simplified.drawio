<mxCell id="Pet-operation-2" value="+ linkOwner()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Pet"><mxGeometry y="169" width="134" height="16" as="geometry"/></mxCell>
<mxCell id="Pet-operation-3" value="+ viewHistory()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Pet"><mxGeometry y="185" width="134" height="16" as="geometry"/></mxCell>
<object id="Notification" label="Notification" tooltip="Represents a user-directed message and its navigation target. Booking changes, care updates and prescription-plan updates can direct the recipient to the related record or checklist. Read state, delivery preferences, push subscriptions and outgoing email are retained as supporting records rather than separate boxes. A notification is not itself a medication occurrence or proof that a dose was taken.
Supporting mappings: user_notifications, notification_preferences, notification_push_subscriptions, mail_queue"><mxCell style="swimlane;html=0;horizontal=1;startSize=30;align=center;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#111111;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;rounded=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1577" y="135" width="176" height="174" as="geometry"/></mxCell></object>
