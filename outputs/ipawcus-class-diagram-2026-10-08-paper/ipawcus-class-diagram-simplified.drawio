<mxCell id="Notification-attribute-4" value="- readAt: DateTime?" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Notification"><mxGeometry y="97" width="176" height="16" as="geometry"/></mxCell>
<mxCell id="Notification-divider" style="line;strokeColor=#111111;" vertex="1" parent="Notification"><mxGeometry y="118" width="176" height="0" as="geometry"/></mxCell>
<mxCell id="Notification-operation-0" value="+ notify()" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" vertex="1" parent="Notification"><mxGeometry y="121" width="176" height="16" as="geometry"/></mxCell>
