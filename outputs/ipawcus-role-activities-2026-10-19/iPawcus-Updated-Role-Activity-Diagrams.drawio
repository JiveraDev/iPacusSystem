<mxCell id="text-0" value="iPawcus  |  Pet Owner Activity Diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="25" width="2220" height="45" as="geometry"/></mxCell>
<mxCell id="text-1" value="Pets, appointments, clinic queue, records, medication checklists, and personal tools" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="78" width="2220" height="28" as="geometry"/></mxCell>
<mxCell id="text-2" value="Current local implementation reviewed: 19 October 2026  |  Rounded box: activity  |  Diamond: decision / merge  |  Small label: responsible actor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="116" width="2220" height="28" as="geometry"/></mxCell>
<mxCell id="text-3" value="Reading the revised diagram" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#171717;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3136" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-4" value="Columns are alternative work areas. Merge diamonds combine alternatives; they do not wait for every activity to finish. Pending reviews may be revisited later." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3175" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-5" value="Use the selected action's validation rules. For a timeout or uncertain write result, refresh the record before resubmitting. Leaving an activity returns to the menu." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3205" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-6" value="Booking route depends on the selected service. Routine grooming and Pet Hotel do not require the clinical queue/diagnosis sequence." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3235" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-7" value="Proof submission is not verified payment. An online call becomes joinable when the assigned veterinarian marks it ready." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3265" width="2220" height="30" as="geometry"/></mxCell>
<mxCell id="text-8" value="Only owned/co-owned pets and owner-visible medical content are available. Prescription checklist entries record reported use." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3295" width="2220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
